{
  "name": "ryvra-markets",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "Ryvra Markets execution baseline",
  "packageManager": "pnpm@10.16.0",
  "type": "module",
  "scripts": {
    "lint": "pnpm typecheck",
    "typecheck": "tsc --noEmit",
